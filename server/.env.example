# Copy this file to `.env` and fill in your own values.
# .env is excluded via .gitignore — never commit the real one.
#
# These are the same three variables documented at the project root.
# The Narrative Engine reads them at startup; if any are missing the
# service will still start, but generation calls will fall back to
# hardcoded lines rather than calling watsonx.ai.

# IBM watsonx.ai credentials — used by pipeline/watsonxClient.js
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=

# Port the Express server listens on (defaults to 3001 if not set)
PORT=3001
